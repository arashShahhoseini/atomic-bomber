<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ControlController"
            prefHeight="400.0" prefWidth="600.0">

    <center>
        <VBox stylesheets="@../CSS/style.css" spacing="10" alignment="CENTER">
            <Label text="Control setting" styleClass="header"/>
            <VBox spacing="10" alignment="CENTER" styleClass="vbox">
                <TextField fx:id="up" maxWidth="50"/>
                <HBox alignment="CENTER" spacing="15">
                    <TextField fx:id="left" maxWidth="50"/>
                    <Button fx:id="apply" maxWidth="50" onMouseClicked="#apply" styleClass="avatar-button">
                        <graphic>
                            <ImageView fitHeight="30" fitWidth="30" fx:id="image"/>
                        </graphic>
                    </Button>
                    <TextField fx:id="right" maxWidth="50"/>
                </HBox>
                <TextField fx:id="down" maxWidth="50"/>
            </VBox>
            <Button text="back" onMouseClicked="#back" maxWidth="300"/>
        </VBox>
    </center>

</BorderPane>
