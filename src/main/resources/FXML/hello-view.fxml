<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Hyperlink?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.HelloController"
            prefHeight="400.0" prefWidth="600.0" stylesheets="@../CSS/style.css">
    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <Label text="Sign Up" styleClass="header"/>
            <TextField fx:id="username" promptText="Username" maxWidth="300"/>
            <TextField fx:id="password" promptText="Password" maxWidth="300"/>
            <TextField fx:id="rePassword" promptText="Re-Enter password" maxWidth="300"/>
            <HBox alignment="CENTER" spacing="10">
                <Button text="sign up" onMouseClicked="#signUp" maxWidth="200"/>
                <Button text="guest" onMouseClicked="#skip" maxWidth="100"/>
            </HBox>
            <HBox alignment="CENTER">
                <Label text="already have an account" styleClass="normal-text"/>
                <Hyperlink text="login" onMouseClicked="#login"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
