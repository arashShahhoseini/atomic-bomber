<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AvatarMenuController"
            prefHeight="400.0" prefWidth="600.0">
    <center>
        <VBox alignment="CENTER" stylesheets="@../CSS/mainMenu.css" spacing="30">
            <Label text="choose your avatar" styleClass="header"/>
            <HBox alignment="CENTER" spacing="10">
                <Button onMouseClicked="#change1" maxWidth="30" minHeight="30" styleClass="avatar-button">
                    <graphic>
                        <ImageView fx:id="image1" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                    </graphic>
                </Button>
                <Button onMouseClicked="#change2" maxWidth="30" minHeight="30" styleClass="avatar-button">
                    <graphic>
                        <ImageView fx:id="image2" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                    </graphic>
                </Button>
                <Button onMouseClicked="#change3" maxWidth="30" minHeight="30" styleClass="avatar-button">
                    <graphic>
                        <ImageView fx:id="image3" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                    </graphic>
                </Button>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Button onMouseClicked="#change4" maxWidth="30" minHeight="30" styleClass="avatar-button">
                    <graphic>
                        <ImageView fx:id="image4" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                    </graphic>
                </Button>
                <Button onMouseClicked="#change5" maxWidth="30" minHeight="30" styleClass="avatar-button">
                    <graphic>
                        <ImageView fx:id="image5" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                    </graphic>
                </Button>
                <Button onMouseClicked="#change6" maxWidth="30" minHeight="30" styleClass="avatar-button">
                    <graphic>
                        <ImageView fx:id="image6" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                    </graphic>
                </Button>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Button onMouseClicked="#change7" maxWidth="30" minHeight="30" styleClass="avatar-button">
                    <graphic>
                        <ImageView fx:id="image7" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                    </graphic>
                </Button>
                <Button onMouseClicked="#change8" maxWidth="30" minHeight="30" styleClass="avatar-button">
                    <graphic>
                        <ImageView fx:id="image8" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                    </graphic>
                </Button>
            </HBox>
            <VBox alignment="CENTER" stylesheets="@../CSS/mainMenu.css" spacing="10">
                <Button fx:id="file" text="Drag your file here" maxWidth="300" onDragOver="#dragAndDrop">
                    <graphic>
                        <ImageView fx:id="imageView" fitWidth="50" fitHeight="50" preserveRatio="true" />
                    </graphic>
                </Button>
                <Button maxWidth="300" text="back" onMouseClicked="#back"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
